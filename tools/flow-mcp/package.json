{
  "name": "agro-flow-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP-сервер АгроОкно: генерация роликов в Google Flow (через отдельный профиль Chrome) и сборка трейлера",
  "type": "module",
  "bin": {
    "agro-flow-mcp": "dist/index.js"
  },
