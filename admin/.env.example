# Адрес проекта Supabase и publishable-ключ (публичный, тот же, что у приложения: EXPO_PUBLIC_SUPABASE_*)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Backend АгроОкно (маршруты /v1/admin/*: блокировка, рассылки, модель помощника)
VITE_API_URL=https://agro-okno-server.onrender.com
# Необязательно: 1 — демо-данные вместо реального API (то же, что npm run dev:mock)
# VITE_MOCK=1
