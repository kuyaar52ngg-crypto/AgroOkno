# Скопируйте в server/.env. Реальные секреты в репозиторий не коммитьте.

PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Supabase (проект agrookno). Публичный URL и publishable-ключ — те же, что в app/.env.local.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Секретный ключ service_role нужен для cron-напоминаний, блокировки пользователей из админ-панели (Supabase Auth Admin API)
# и Expo push рассылок (push_tokens). Без него эти функции отключены. Никогда не отдавайте его клиенту.
SUPABASE_SERVICE_ROLE_KEY=

# Помощник через OpenRouter (https://openrouter.ai/keys). Без OPENROUTER_API_KEY работает правиловый разбор фраз (llm: rules).
# Модель для всех пользователей выбирает администратор в приложении (хранится в БД, кеш 30 с);
# OPENROUTER_MODEL — запасной вариант, если настройку из БД прочитать не удалось.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Распознавание речи: mock | yandex | openai
STT_PROVIDER=mock
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# OPENAI_* — только для распознавания речи (Whisper), не для помощника.
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1

# Лимит запросов к помощнику (сообщения и голос) на пользователя; 0 — без ограничения.
ASSISTANT_RATE_PER_MINUTE=10
ASSISTANT_RATE_PER_DAY=200

# Напоминания: cron в 09:00 по региону TZ_REGION; ручной запуск POST /v1/reminders/run с Bearer CRON_SECRET.
CRON_SECRET=
CRON_ENABLED=true
TZ_REGION=Asia/Yakutsk

# Разрешённые источники CORS через запятую (* — любые; для Expo Go/нативных клиентов CORS не нужен).
CORS_ORIGINS=*

# Каталог с бланками (xlsx/шрифты). По умолчанию ../app/templates (в Docker — /app/templates).
# AGRO_TEMPLATES_DIR=

# Необязательно: мониторинг ошибок в Sentry (@sentry/node). Без SENTRY_DSN выключен: ничего не инициализируется, сетевых вызовов нет.
# В Sentry уходят только ошибки 5xx (метод, шаблон маршрута, статус, id пользователя), без тел запросов и персональных данных.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
