# Скопируйте в server/.env. Реальные секреты в репозиторий не коммитьте.

PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Supabase (проект agrookno). Публичный URL и publishable-ключ — те же, что в app/.env.local.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Секретный ключ service_role нужен ТОЛЬКО для cron-задачи напоминаний. Никогда не отдавайте его клиенту.
SUPABASE_SERVICE_ROLE_KEY=

# Помощник: без ANTHROPIC_API_KEY работает правиловый разбор фраз (llm: rules).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Распознавание речи: mock | yandex | openai
STT_PROVIDER=mock
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1

# Напоминания: cron в 09:00 по региону TZ_REGION; ручной запуск POST /v1/reminders/run с Bearer CRON_SECRET.
CRON_SECRET=
CRON_ENABLED=true
TZ_REGION=Asia/Yakutsk

# Разрешённые источники CORS через запятую (* — любые; для Expo Go/нативных клиентов CORS не нужен).
CORS_ORIGINS=*

# Каталог с бланками (xlsx/шрифты). По умолчанию ../app/templates (в Docker — /app/templates).
# AGRO_TEMPLATES_DIR=
