# Скопируйте в .env.local и заполните значениями из Supabase (Project Settings → API).
# Оба значения публичные и безопасны для клиента; доступ к данным ограничивает RLS.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Базовый URL сервера с API. Нужен на нативе (iOS/Android) и при локальной веб-разработке; на вебе, развёрнутом на Vercel, не нужен (/api/...).
#  • Node.js-сервер АгроОкно (server/): помощник, голос, напоминания, отчёты. Телефон в LAN: http://<IP-компьютера>:3001
#  • запасной вариант без помощника — Vercel-функции app/api: https://<ваш-проект>.vercel.app
EXPO_PUBLIC_API_URL=http://192.168.0.60:3001

# Необязательно: зафиксировать «сегодня» для демо (YYYY-MM-DD). Без значения берётся текущая дата по Якутску.
# EXPO_PUBLIC_DEMO_DATE=2026-10-23
